{
  "name": "bolt-browser",
  "version": "1.0.0",
  "description": "Bolt Browser — Chromium desktop browser and mobile companion",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "cap sync",
    "build:preload": "esbuild preload.js --bundle --platform=node --format=cjs --external:electron --outfile=preload.bundle.js",
    "prestart": "npm run build:preload",
    "predev": "npm run build:preload",
    "predist": "npm run build:preload",
    "predist:win": "npm run build:preload",
    "predist:mac": "npm run build:preload",
    "predist:linux": "npm run build:preload"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "electron-chrome-extensions": "4.10.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.bolt.browser",
    "productName": "Bolt Browser",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "newtab.html",
      "extensions.html",
      "internal.html",
      "crash.html",
      "icon.svg",
      "icon-192.png",
      "extensions/**/*",
      "permissions.js",
      "preload.bundle.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bolt-Browser-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Bolt uses your camera when you allow a website to make video calls.",
        "NSMicrophoneUsageDescription": "Bolt uses your microphone when you allow a website to make audio or video calls.",
        "NSLocationUsageDescription": "Bolt shares your location only when you grant a website location permission.",
        "NSBluetoothAlwaysUsageDescription": "Bolt accesses Bluetooth devices only when you select a device for a website.",
        "NSAudioCaptureUsageDescription": "Bolt captures system audio only when you explicitly choose to share it."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Bolt Browser maintainers"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bolt Browser",
      "deleteAppDataOnUninstall": false
    }
  }
}
